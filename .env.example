# Userside source, read-only access
US_DB_HOST=
US_DB_NAME=
US_DB_USER=
US_DB_PASS=
US_DB_PORT=5432
US_MAP_ID=3
US_SOURCE_SYSTEM=userside
# Verified legacy geometry uses latitude as its first coordinate.
US_COORD_AXES=lat_lon
SYNC_BATCH_SIZE=500
# skip: exclude invalid objects and publish valid data; fail: stop on object errors.
SYNC_INVALID_OBJECTS=skip
# bridge: reconstruct failed cable-group pieces; drop: omit them (both publish warnings).
US_CABLE_GROUP_ERROR_POLICY=bridge
# Local reports; Docker mounts this host directory at /reports.
SYNC_REPORT_DIR=./reports/sync
# For Docker bind-mount writes, set these to the report directory owner's UID/GID.
SYNC_REPORT_UID=10001
SYNC_REPORT_GID=10001

# Docker stack: separate destination, never the Userside database.
# Use different passwords. Quote values containing $ with single quotes.
MAP_DB_PASSWORD=
MAP_API_DB_PASSWORD=
MAP_TILES_VECTOR_DB_PASSWORD=
MAP_TILES_RASTER_DB_PASSWORD=
MAP_IMAGE_TAG=local
MAP_API_BIND=127.0.0.1

MAP_API_PORT=8000
MAP_API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000
NUXT_PUBLIC_MAP_API_BASE=/api/map
NUXT_PUBLIC_MAP_ID=3
NUXT_PUBLIC_MAP_LONGITUDE=37.664
NUXT_PUBLIC_MAP_LATITUDE=55.76005
NUXT_PUBLIC_MAP_ZOOM=15
NUXT_PUBLIC_MAP_ICON_BASE_SIZE=24
NUXT_PUBLIC_MAP_ICON_MIN_ZOOM=15
NUXT_PUBLIC_MAP_LABEL_MIN_ZOOM=16
NUXT_PUBLIC_MAP_TILES_URL=https://tile2.maps.2gis.com/tiles?x={x}&y={y}&z={z}
NUXT_PUBLIC_MAP_ATTRIBUTION=© 2GIS
MAP_API_POOL_MIN=1
MAP_API_POOL_MAX=10
MAP_API_POOL_TIMEOUT=5
MAP_API_CONNECT_TIMEOUT_SECONDS=10
MAP_API_STATEMENT_TIMEOUT_MS=30000
MAP_API_LOCK_TIMEOUT_MS=5000
MAP_API_TTL_SECONDS=600
MAP_API_PRELOAD_TIMEOUT_SECONDS=120
MAP_API_MAX_OBJECTS=100000
MAP_API_MAX_VERTICES=2000000
MAP_API_HARD_VERTICES=100000
MAP_API_BATCH_OBJECTS=100
MAP_API_BATCH_VERTICES=5000

# Optional direct Python execution against an externally accessible PostGIS.
# Compose builds internal DSNs automatically and does not publish the DB port.
MAP_DB_URL=
MAP_API_DATABASE_URL=
MAP_API_SOURCE_SYSTEM=userside
# Comma-separated cable type IDs shown by map preload; imported cable rows remain stored.
MAP_API_VISIBLE_CABLE_TYPE_IDS=1
MAP_API_HOST=127.0.0.1

# Manual vector worker: a separate destination role, never the API/source DSN.
# Compose derives internal worker DSNs; these URLs are only for direct Python CLI.
MAP_TILES_VECTOR_DATABASE_URL=
TILES_ROOT=./tiles
TILES_MINZOOM=1
TILES_VECTOR_MAXZOOM=14
TILES_DISPLAY_MAXZOOM=18
TILES_CABLE_TYPE_IDS=1
TILES_CONCURRENCY=2
MAP_TILES_RASTER_DATABASE_URL=
# XYZ19 is logical raster zoom18 with tileSize256; XYZ15 includes short cables.
TILES_RASTER_PREBAKE_MAX=19

# Scoped GIS metadata/details token administration (admin destination only).
MAP_TOKEN_ADMIN_DATABASE_URL=
TILES_PUBLIC_BASE_URL=http://localhost:8000
MAP_REDIS_URL=
TILES_VERSION_STATUS_TTL_SECONDS=30
# A: none (known URL), B: hmac (signed path-prefix).
TILES_XYZ_SIGNING=none
TILES_HMAC_SECRET=
TILES_SIGNATURE_TTL_SECONDS=86400
TILES_LAG=banner
TILES_CATALOG_POLL_SECONDS=0
# Time for both manual builds + validation + publish, measured per deployment.
TILES_LAG_GRACE_SECONDS=210

# Nuxt deployment default: change and restart/rebuild frontend (no hot reload).
# none/vector/raster are available; none keeps the legacy object protocol.
CABLE_TILES=none
# Optional Nuxt runtime override of CABLE_TILES (use one setting):
# NUXT_PUBLIC_CABLE_TILES=vector
# Server-only scoped token (metadata + details); never use a NUXT_PUBLIC key.
NUXT_MAP_TILES_TOKEN=

# SeaweedFS S3: no public ports; generate two independent secret keys (>=32 chars).
TILES_STORAGE=s3
TILES_S3_BUCKET=map-tiles
TILES_S3_WORKER_ACCESS_KEY=map-worker
TILES_S3_WORKER_SECRET_KEY=
TILES_S3_API_ACCESS_KEY=map-api
TILES_S3_API_SECRET_KEY=
# Direct Python CLI only (Compose injects these with the correct role):
# TILES_S3_ENDPOINT=http://seaweedfs:8333
# TILES_S3_ACCESS_KEY=
# TILES_S3_SECRET_KEY=

# Recycle raster processes after a bounded number of tiles each.
TILES_TASKS_PER_PROCESS=256

# SeaweedFS data volume capacity; metadata/temporary vacuum space are additional.
SEAWEED_VOLUME_SIZE_MB=128
SEAWEED_VOLUME_MAX=32
